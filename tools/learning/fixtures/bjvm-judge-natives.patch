diff --git a/natives/share/jdk/internal/jimage/NativeImageBuffer.c b/natives/share/jdk/internal/jimage/NativeImageBuffer.c
index ec20d90..36671a5 100644
--- a/natives/share/jdk/internal/jimage/NativeImageBuffer.c
+++ b/natives/share/jdk/internal/jimage/NativeImageBuffer.c
@@ -1,5 +1,50 @@
 #include <natives-dsl.h>
+#include <stdio.h>
 
+// JDK 约定：返回 jimage 文件的内存映射。wasm 里没有真正的 mmap，就把整个
+// 文件读进 byte[]，再用 ByteBuffer.wrap 包一层——ImageReader 只走 buffer
+// 的 get/getInt 接口，不区分 direct/heap。
 DECLARE_NATIVE("jdk/internal/jimage", NativeImageBuffer, getNativeMap, "(Ljava/lang/String;)Ljava/nio/ByteBuffer;") {
+  if (!args[0].handle->obj)
+    return value_null();
+
+  heap_string path = AsHeapString(args[0].handle->obj, on_oom);
+  FILE *f = fopen(path.chars, "rb");
+  free_heap_str(path);
+  if (!f)
+    return value_null();
+
+  fseek(f, 0, SEEK_END);
+  long size = ftell(f);
+  fseek(f, 0, SEEK_SET);
+  if (size < 0 || size > 512 * 1024 * 1024) {
+    fclose(f);
+    return value_null();
+  }
+
+  obj_header *bytes = CreatePrimitiveArray1D(thread, TYPE_KIND_BYTE, (int)size);
+  if (!bytes) {
+    fclose(f);
+    return value_null();
+  }
+  if (fread(ArrayData(bytes), 1, (size_t)size, f) != (size_t)size) {
+    fclose(f);
+    return value_null();
+  }
+  fclose(f);
+
+  classdesc *bb = bootstrap_lookup_class(thread, STR("java/nio/ByteBuffer"));
+  if (!bb)
+    return value_null();
+  cp_method *wrap = method_lookup(bb, STR("wrap"), STR("([B)Ljava/nio/ByteBuffer;"), false, false);
+  if (!wrap)
+    return value_null();
+  stack_value argv[1] = {{.obj = bytes}};
+  stack_value result = call_interpreter_synchronous(thread, wrap, argv);
+  if (thread->current_exception)
+    return value_null();
+  return result;
+
+on_oom:
   return value_null();
 }
