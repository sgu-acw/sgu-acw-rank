+DECLARE_NATIVE("sun/nio/ch", FileDispatcherImpl, init0, "()V") { return value_null(); }
+
+// FileChannel 路径：nio 层直接读写 FileDescriptor 里的 unix fd。
+// 直接缓冲区的地址就是 wasm 线性内存偏移。
+
+static s32 ufd_read_fd(obj_header *fdobj) {
+  return fdobj ? LoadFieldInt(fdobj, "fd") : -1;
+}
+
+DECLARE_NATIVE("sun/nio/ch", UnixFileDispatcherImpl, read0, "(Ljava/io/FileDescriptor;JI)I") {
+  DCHECK(argc == 3);
+  s32 fd = ufd_read_fd(args[0].handle->obj);
+  if (fd < 0) {
+    raise_vm_exception(thread, STR("java/io/IOException"), STR("Bad file descriptor"));
+    return value_null();
+  }
+  ssize_t n;
+  if (fd == 0 && thread->vm->read_stdin) {
+    n = thread->vm->read_stdin((void *)(uintptr_t)args[1].l, args[2].i, thread->vm->stdio_override_param);
+  } else {
+    n = read(fd, (void *)(uintptr_t)args[1].l, (size_t)args[2].i);
+  }
+  if (n < 0) {
+    raise_vm_exception(thread, STR("java/io/IOException"), STR("Read failed"));
+    return value_null();
+  }
+  return (stack_value){.i = n == 0 ? -1 : (s32)n};
+}
+
+DECLARE_NATIVE("sun/nio/ch", UnixFileDispatcherImpl, pread0, "(Ljava/io/FileDescriptor;JIJ)I") {
