+  if (fd < 0) {
+    raise_vm_exception(thread, STR("java/io/IOException"), STR("Bad file descriptor"));
+    return value_null();
+  }
+  ssize_t n = pread(fd, (void *)(uintptr_t)args[1].l, (size_t)args[2].i, (off_t)args[3].l);
+  if (n < 0) {
+    raise_vm_exception(thread, STR("java/io/IOException"), STR("Pread failed"));
