---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Compass, Home } from 'lucide-vue-next';
---

<BaseLayout title="SGU ACW - 页面不存在">
  <div class="mx-auto flex min-h-[60vh] max-w-md flex-col items-center justify-center text-center">
    <p class="font-mono text-5xl font-semibold tracking-tight text-muted-foreground/30">404</p>
    <h1 class="mt-4 text-lg font-medium">这个页面不存在</h1>
    <p class="mt-2 text-sm text-muted-foreground">
      链接可能已经失效，或者地址打错了。
    </p>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-md border border-border/40 px-4 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground"
      >
        <Home class="h-4 w-4" />
        回到首页
      </a>
      <a
        href="/nav"
        class="inline-flex items-center gap-2 rounded-md border border-border/40 px-4 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground"
      >
        <Compass class="h-4 w-4" />
        去看导航
      </a>
    </div>
  </div>
</BaseLayout>
