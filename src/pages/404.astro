---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ArrowLeft, Compass, Home } from 'lucide-vue-next';
---

<BaseLayout title="SGU ACW - 页面不存在">
  <div class="mx-auto flex min-h-[60vh] w-full max-w-md flex-col items-center justify-center text-center">
    <p class="font-mono text-5xl font-semibold tracking-tight text-muted-foreground/30">404</p>
    <h1 class="mt-4 text-lg font-medium">这个页面不存在</h1>
    <p class="mt-2 text-sm text-muted-foreground">
      链接可能已经失效，或者地址打错了
    </p>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-3">
      <!--
        返回上一页放在最前面，而且用实心按钮。
        
        从题单、博客这些地方点进一个坏链接时，用户想的是「退回去接着看」，
        不是「回站点首页重新开始」。把人扔回首页等于丢掉刚才的位置。
        
        用 history.back() 而不是固定的链接：从哪来的就回哪去。
      -->
      <button
        id="go-back"
        class="inline-flex items-center gap-2 rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground transition-colors hover:bg-primary/90 active:scale-[0.97]"
      >
        <ArrowLeft class="h-4 w-4" />
        返回上一页
      </button>
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-md border border-border/40 px-4 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground"
      >
        <Home class="h-4 w-4" />
        回到首页
      </a>
      <a
        href="/nav"
        class="inline-flex items-center gap-2 rounded-md border border-border/40 px-4 py-2 text-sm font-medium transition-colors hover:bg-accent hover:text-accent-foreground"
      >
        <Compass class="h-4 w-4" />
        去看导航
      </a>
    </div>
  </div>

  <!--
    没有上一页时（比如直接把坏链接粘进地址栏），「返回上一页」按了没反应，
    所以要把它藏起来。history.length 为 1 说明这是第一个页面。
  -->
  <script is:inline>
    (function () {
      var button = document.getElementById('go-back');
      if (!button) return;
      if (window.history.length <= 1) {
        button.style.display = 'none';
        return;
      }
      button.addEventListener('click', function () {
        window.history.back();
      });
    })();
  </script>
</BaseLayout>
