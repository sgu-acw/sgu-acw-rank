---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  ArrowUpRight,
  BookOpen,
  Code2,
  GraduationCap,
  Laptop,
  MessageCircle,
  MonitorSmartphone,
  Puzzle,
  Terminal,
  Trophy,
} from 'lucide-vue-next';

interface NavLink {
  name: string;
  url: string;
  desc?: string;
  internal?: boolean;
}

interface NavSection {
  title: string;
  icon: any;
  links: NavLink[];
}

const qqGroup = '905189428';

const sections: NavSection[] = [
  {
    title: '站内',
    icon: Trophy,
    links: [
      { name: '成员练习榜', url: '/practice', desc: '训练量与 Rating 榜单', internal: true },
      { name: '每日一题', url: '/daily', desc: '三个难度档各一道', internal: true },
      { name: '工作坊状态', url: '/status', internal: true },
    ],
  },
  {
    title: 'OJ',
    icon: Code2,
    links: [
      { name: 'Codeforces', url: 'https://codeforces.com/', desc: '主力刷题平台' },
      { name: 'AtCoder', url: 'https://atcoder.jp/', desc: '基础题练习 (ABC)' },
      { name: '洛谷', url: 'https://www.luogu.com.cn/', desc: '模板题练习' },
      { name: 'qoj', url: 'https://qoj.ac/', desc: '参加以往的正赛' },
      { name: '牛客', url: 'https://ac.nowcoder.com/' },
    ],
  },
  {
    title: '资料',
    icon: BookOpen,
    links: [{ name: 'OI WIKI', url: 'https://oi-wiki.org/', desc: '算法竞赛知识百科' }],
  },
  {
    title: '工具（网页）',
    icon: MonitorSmartphone,
    links: [
      { name: 'CList', url: 'https://clist.by/', desc: '评级、比赛日历' },
      { name: 'CF Visualizer', url: 'https://cfviz.netlify.app/', desc: '个人比赛数据可视' },
      { name: 'CF Tracker', url: 'https://cftracker.netlify.app/', desc: '个人提交统计、题单管理' },
      {
        name: 'AtCoder Problems',
        url: 'https://kenkoooo.com/atcoder/#/table/All',
        desc: 'AtCoder 题目列表、个人数据可视',
      },
      { name: 'CPC Finder', url: 'https://cpcfinder.com/', desc: '区域赛获奖查询' },
    ],
  },
  {
    title: '工具（插件）',
    icon: Puzzle,
    links: [
      {
        name: 'CF Better',
        url: 'https://greasyfork.org/zh-CN/scripts/465777-codeforces-better#google_vignette',
        desc: 'Codeforces 增强、翻译。翻译 API 建议用 LLM（如 DS / Qwen），充十块钱能用很久',
      },
      {
        name: 'AtCoder Better',
        url: 'https://greasyfork.org/zh-CN/scripts/471106-atcoder-better',
        desc: 'AtCoder 增强、翻译',
      },
      {
        name: 'Competitive Companion',
        url: 'https://github.com/jmerle/competitive-companion#readme',
      },
      { name: 'Carrot', url: 'https://github.com/meooow25/carrot', desc: 'CF 分数预测' },
    ],
  },
  {
    title: 'IDE / 编辑器',
    icon: Laptop,
    links: [
      { name: 'CLion', url: 'https://www.jetbrains.com.cn/clion/download' },
      { name: 'PyCharm', url: 'https://www.jetbrains.com/pycharm/download' },
      { name: 'VSCode', url: 'https://code.visualstudio.com/' },
      {
        name: '小熊猫 C++',
        url: 'http://royqh.net/redpandacpp/',
      },
    ],
  },
  {
    title: 'VSCode 插件',
    icon: Terminal,
    links: [
      {
        name: 'Competitive Programming Helper',
        url: 'https://marketplace.visualstudio.com/items?itemName=DivyanshuAgrawal.competitive-programming-helper',
        desc: '代码补全、代码片段，建议配合 Competitive Companion 使用',
      },
      {
        name: 'Cpp Runner',
        url: 'https://marketplace.visualstudio.com/items?itemName=franneck94.c-cpp-runner',
        desc: '代码运行',
      },
    ],
  },
];
---

<BaseLayout title="算法竞赛工作坊 - 导航">
  <div class="mx-auto w-full max-w-5xl">
    <header class="mb-6">
      <h1 class="flex items-center gap-2 text-xl font-semibold tracking-tight">
        <GraduationCap class="h-5 w-5 text-muted-foreground" />
        导航
      </h1>
    </header>

    <a
      href={`https://qm.qq.com/q/${qqGroup}`}
      target="_blank"
      rel="noreferrer"
      class="group mb-8 flex items-center justify-between gap-4 rounded-lg border border-border/40 bg-card p-4 transition-colors hover:border-border hover:bg-muted/40"
    >
      <span class="flex items-center gap-3">
        <MessageCircle class="h-5 w-5 text-muted-foreground" />
        <span>
          <span class="block text-sm font-medium">QQ 群</span>
          <span class="block text-xs text-muted-foreground">通知主要在这里发</span>
        </span>
      </span>
      <span class="flex items-center gap-2 font-mono text-sm text-muted-foreground">
        {qqGroup}
        <ArrowUpRight
          class="h-4 w-4 text-muted-foreground/40 transition-colors group-hover:text-primary"
        />
      </span>
    </a>

    <div class="space-y-8">
      {
        sections.map((section) => (
          <section>
            <h2 class="flex items-center gap-2 text-sm font-medium">
              <section.icon class="h-4 w-4 text-muted-foreground" />
              {section.title}
            </h2>
            <div class="mt-3 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
              {section.links.map((link) => (
                <a
                  href={link.url}
                  target={link.internal ? undefined : '_blank'}
                  rel={link.internal ? undefined : 'noreferrer'}
                  class="group flex flex-col justify-between rounded-lg border border-border/40 bg-card p-4 transition-colors hover:border-border hover:bg-muted/40"
                >
                  <span class="flex items-start justify-between gap-2">
                    <span class="text-sm font-medium">{link.name}</span>
                    {link.internal ? (
                      <span class="shrink-0 rounded border border-border/40 px-1.5 py-0.5 text-[10px] text-muted-foreground/60">
                        站内
                      </span>
                    ) : (
                      <ArrowUpRight class="h-3.5 w-3.5 shrink-0 text-muted-foreground/30 transition-colors group-hover:text-primary" />
                    )}
                  </span>
                  {link.desc && (
                    <span class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
                      {link.desc}
                    </span>
                  )}
                </a>
              ))}
            </div>
          </section>
        ))
      }
    </div>
  </div>
</BaseLayout>
