---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = await getCollection('blog');
const sorted = posts.sort((a, b) => {
  return (b.data.sortOrder ?? 0) - (a.data.sortOrder ?? 0);
});

// 列表只需要标题和一段摘要。摘要直接从 Markdown 原文里抽，不渲染整篇——
// 列表页没人看正文，白渲染一遍只是拖慢构建。
const postsWithContent = sorted.map((post) => {
  const plainText = post.body
      ?.replace(/^---[\s\S]*?---\n*/m, '') // remove frontmatter
      ?.replace(/#+\s/g, '')               // remove headings
      ?.replace(/\[([^\]]+)\]\([^)]+\)/g, '$1') // links -> text
      ?.replace(/[*_~`]/g, '')             // remove formatting
      ?.replace(/\|.*\|/g, '')             // remove table rows
      ?.replace(/---/g, '')                // remove hr
      ?.replace(/!\[.*?\]\(.*?\)/g, '')    // remove images
      ?.trim()
      ?.slice(0, 200) || '';
  return { post, excerpt: plainText };
});
---

<BaseLayout title="SGU ACW - 博客">
  <div class="mx-auto w-full max-w-3xl">
    <div class="divide-y divide-border/50">
      {postsWithContent.map(({ post, excerpt }) => (
        <a href={`/blog/${post.id.replace(/\.md$/, '')}`} class="block group">
          <article class="row-action -mx-2 rounded-lg px-2 py-6 md:-mx-4 md:px-4 md:py-8">
            <h2 class="text-base md:text-lg font-medium tracking-tight group-hover:text-primary transition-colors">
              {post.data.title}
            </h2>
            {excerpt && (
              <p class="mt-2 text-sm text-muted-foreground leading-relaxed line-clamp-2">
                {excerpt}{excerpt.length >= 200 ? '…' : ''}
              </p>
            )}
            <span class="inline-flex items-center gap-1 mt-3 text-xs text-muted-foreground/70 group-hover:text-primary transition-colors">
              阅读全文
              <svg class="w-3.5 h-3.5 transition-transform group-hover:translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
              </svg>
            </span>
          </article>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
