---
import '../styles/globals.css'
import AppNav from '../components/AppNav.vue'
import MobileTabBar from '../components/MobileTabBar.vue'
import ThemeToggle from '../components/ThemeToggle.vue'

interface Props {
  title?: string
}

const { title = 'SGU 算法竞赛工作坊' } = Astro.props
---

<html lang="zh">
<head>
  <meta charset="UTF-8" />
  <!--
    viewport-fit=cover：让页面铺到 iPhone 的刘海和底部横条区域，
    再用 env(safe-area-inset-*) 把内容推回安全区内。
    不加这个，刘海横屏时会把左侧内容盖住。
  -->
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0, viewport-fit=cover"
  />
  <meta name="theme-color" media="(prefers-color-scheme: light)" content="#ffffff" />
  <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#111113" />
  <link rel="icon" href="/favicon.ico" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css" />
  <title>{title}</title>
</head>
<body>
  <!--
    顶栏。

    移动端不再有汉堡按钮：导航改成了底部标签栏，抽屉就多余了。手机上
    顶栏只放站名和主题开关。
  -->
  <header
    class="sticky top-0 z-50 w-full border-b border-border/50 bg-sidebar/80 backdrop-blur-md supports-[backdrop-filter]:bg-sidebar/60"
    style="padding-top: env(safe-area-inset-top)"
  >
    <div class="flex h-14 items-center px-4">
      <a href="/" class="font-semibold text-lg">
        <span class="hidden md:inline">SGU 算法竞赛工作坊</span>
        <span class="md:hidden">SGU ACW</span>
      </a>
      <div class="flex-1" />
      <ThemeToggle client:load />
    </div>
  </header>
  <div class="flex">
    <AppNav client:load />
    <!--
      内容区。

      底部留出标签栏的高度（4rem）加安全区，否则最后一行内容会被标签栏
      盖住。移动端没有侧边栏，所以 md 以下不加左边距。
    -->
    <main
      class="min-h-[calc(100vh-3.5rem)] flex-1 px-3 py-4 pb-[calc(5rem+env(safe-area-inset-bottom))] transition-all sm:px-4 md:ml-64 md:py-6 md:pb-6"
    >
      <slot />
    </main>
  </div>

  <!-- 底部标签栏。md 以上自己隐藏。 -->
  <MobileTabBar client:load />

  <!-- Theme init script: runs before paint to prevent flash -->
  <script is:inline>
    const theme = localStorage.getItem('theme');
    if (theme === 'light') {
      document.documentElement.classList.remove('dark');
    } else {
      document.documentElement.classList.add('dark');
    }
  </script>
</body>
</html>
